# Copy to .env.local for local development (never commit .env.local).
# Every variable is optional: the editor and local export work without any of them.
# Features that need a missing variable report "not configured" instead of failing.

# Base URL used to build OAuth redirect URIs (e.g. http://localhost:3000 or your Vercel domain).
NEXTAUTH_URL=

# Vercel KV (Redis) for OAuth session/state and token storage. Both required for YouTube/TikTok sign-in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# AES-256-GCM key for encrypting OAuth tokens at rest in KV: 32 random bytes, base64.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#            or:  openssl rand -base64 32
# Required in production for YouTube/TikTok connect (refused with token_encryption_not_configured
# when missing). In development, tokens are stored unencrypted with a warning if unset.
TOKEN_ENC_KEY=

# Google OAuth client (YouTube connect, upload, analytics API routes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok Content Posting API app credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Spotify Web API app credentials (client-credentials flow for track search / metadata fill).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OpenAI API key for Whisper auto-captions (/api/whisper).
OPENAI_API_KEY=

# Free auto-caption allowance per anonymous user (signed-in session or IP) per UTC day, in minutes.
# Defaults to 60. In production, /api/whisper and /api/spotify/search require KV for rate limiting.
WHISPER_DAILY_MINUTES=
